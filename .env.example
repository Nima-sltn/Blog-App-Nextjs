# Base URL of the backend API (no trailing slash).
# Used by the service layer, middleware auth and server components.
NEXT_PUBLIC_BASE_URL=http://localhost:8000/api

# Public origin of this Next.js app.
# Used for metadataBase, sitemap.xml and robots.txt absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deployment environment (set automatically by Next.js).
NODE_ENV=development
